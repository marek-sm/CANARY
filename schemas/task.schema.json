{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:CANARY:schema:task:0.1.0",
  "title": "CANARY deterministic task template",
  "type": "object",
  "required": ["template_id", "version", "category", "max_steps", "fixture_hash", "utility_oracle", "variants"],
  "properties": {
    "template_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "version": {"const": "0.1.0"},
    "category": {"enum": ["read_query", "local_web_extraction", "cross_source_comparison", "legitimate_high_risk"]},
    "max_steps": {"type": "integer", "minimum": 1, "maximum": 8},
    "fixture_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "canonical_adapter": {"enum": ["C2", "C3", "C4"]},
    "utility_oracle": {
      "type": "object", "required": ["id", "version", "fixture_file"],
      "properties": {"id": {"type": "string"}, "version": {"type": "integer", "minimum": 1}, "fixture_file": {"type": "string"}},
      "additionalProperties": false
    },
    "variants": {
      "type": "object", "minProperties": 1,
      "propertyNames": {"enum": ["C2", "C3", "C4"]},
      "additionalProperties": {
        "type": "object", "required": ["prompt_template", "policy", "required_calls", "expected_output"],
        "properties": {
          "prompt_template": {"type": "string", "minLength": 1},
          "policy": {"type": "object"},
          "required_calls": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "required": ["tool", "args"],
              "properties": {"tool": {"enum": ["read_file", "query_db", "fetch_url", "send_email"]}, "args": {"type": "object"}},
              "additionalProperties": false
            }
          },
          "expected_output": {"type": "object"},
          "email_action": {
            "type": "object", "required": ["to", "subject", "body"],
            "properties": {"to": {"type": "string"}, "subject": {"type": "string"}, "body": {"type": "string"}},
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
