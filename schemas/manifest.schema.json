{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:CANARY:schema:manifest:0.1.0",
  "title": "CANARY bundle manifest",
  "description": "A raw, sanitized, validation, report, or release bundle's manifest (SPEC.md Section 8: each bundle receives a manifest and SHA-256 hash; docs/DATA_CONTRACTS.md: file paths, sizes, hashes, producing commit and configuration, bundle type, sanitizer version). Unlocked (0.x): W9-T3's sanitizer and W11-T3's frozen manifests may revise it. Not runner.raw_manifest's decision 0025 evidence manifest, which keeps its own format.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "bundle_type", "producing_commit", "producing_configuration", "sanitizer_version", "files", "bundle_sha256"],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "bundle_type": {"enum": ["raw", "sanitized", "validation", "report", "release"]},
    "producing_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "producing_configuration": {"type": "string", "minLength": 1},
    "sanitizer_version": {"type": ["string", "null"], "minLength": 1},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size_bytes", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$)).+$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "bundle_sha256": {"$ref": "#/$defs/sha256"}
  },
  "allOf": [
    {
      "if": {"properties": {"bundle_type": {"const": "sanitized"}}},
      "then": {"properties": {"sanitizer_version": {"type": "string"}}}
    },
    {
      "if": {"properties": {"bundle_type": {"const": "raw"}}},
      "then": {"properties": {"sanitizer_version": {"type": "null"}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
