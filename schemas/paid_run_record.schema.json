{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:CANARY:schema:paid_run_record:1.1.0",
  "title": "CANARY paid-run record",
  "description": "The project lead's dated record that every paid-run condition holds (TASKS.md paid-run condition; decision 0023). runner.paid_run refuses any non-mock provider unless this record validates and is committed, its commit is on this history, the running tool sandbox equals the recorded mock grid's, the hashed code equals code_sha256, the installed environment equals environment, and the mock grid at run_path still matches its digests and passes every check.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_on",
    "recorded_by",
    "recorded_commit",
    "sandbox",
    "conditions",
    "code_sha256",
    "environment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "recorded_on": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "recorded_by": {
      "type": "string",
      "minLength": 1
    },
    "recorded_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sandbox": {
      "type": "string",
      "pattern": "^(macos-sandbox-exec|linux-bwrap):tool-sandbox-v[0-9.]+:[0-9a-f]{16}$"
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_result_delivery",
        "mock_grid",
        "request_to_effect",
        "tool_sandbox"
      ],
      "properties": {
        "tool_result_delivery": {
          "$ref": "#/$defs/merged"
        },
        "request_to_effect": {
          "$ref": "#/$defs/merged"
        },
        "tool_sandbox": {
          "$ref": "#/$defs/merged"
        },
        "mock_grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "experiment_id",
            "trials",
            "verify_complete",
            "tool_sandbox",
            "run_path",
            "run_files_sha256",
            "results_sha256",
            "events_sha256"
          ],
          "properties": {
            "experiment_id": {
              "type": "string",
              "minLength": 1
            },
            "trials": {
              "const": 90
            },
            "verify_complete": {
              "const": true
            },
            "tool_sandbox": {
              "type": "string",
              "minLength": 1
            },
            "run_path": {
              "type": "string",
              "pattern": "^results/[A-Za-z0-9._/-]+$"
            },
            "run_files_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "results_sha256": {
              "$ref": "#/$defs/sha256"
            },
            "events_sha256": {
              "$ref": "#/$defs/sha256"
            }
          }
        }
      }
    },
    "code_sha256": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^((agent|analysis|channels|defenses|oracles|runner|tasks|tools|corpus|fixtures|schemas)/|paper/estimand_manifest\\.json$|protocol/development_grid_spec\\.json$|uv\\.lock$)"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "packages"
      ],
      "properties": {
        "python": {
          "type": "string",
          "minLength": 1
        },
        "packages": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "merged": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "merged_in"
      ],
      "properties": {
        "merged_in": {
          "type": "string",
          "pattern": "^#[0-9]+$"
        }
      }
    }
  }
}
